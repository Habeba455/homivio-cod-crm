# Copy this file to .env.local for local development. .env.local is git-ignored.
# Never commit real values. This file contains placeholders only.
#
# Local Supabase (supabase start) normally serves http://127.0.0.1:54321.

# Public: safe in the browser, protected by Row Level Security.
# Must be an https origin, or http://localhost or http://127.0.0.1 for local development.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Must be a publishable key (sb_publishable_...). Never put a secret or service-role key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_key

# Server-only: used by operator scripts in scripts/ (import, seed). Never set on Vercel.
# The app does not read this variable. Never give it a NEXT_PUBLIC_ prefix.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
